# ==============================================================================
# SAFETY DESK BACKEND CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust values for your environment.

# ------------------------------------------------------------------------------
# 1. MinIO Object Storage (Images & Evidence)
# ------------------------------------------------------------------------------
# Production MinIO defaults: API port 9000, Web Console port 9001
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=safety-media
MINIO_SECURE=False

# ------------------------------------------------------------------------------
# 2. PostgreSQL Relational Database
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=safety_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Set to True to allow SQLite fallback when PostgreSQL server is not reachable
DB_ALLOW_SQLITE_FALLBACK=True

# ------------------------------------------------------------------------------
# 3. Django Server Configuration
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=django-insecure-safety-desk-monolith-key-change-in-production
DJANGO_DEBUG=True
DJANGO_PORT=8000
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

