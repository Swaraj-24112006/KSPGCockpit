<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- 1. Security & Request Filtering -->
    <security>
      <requestFiltering allowDoubleEscaping="true">
        <!-- Allow uploads up to 100 MB (104857600 bytes) for Excel/BOM/Stock/MB51 files -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <!-- 2. URL Rewrite Rules -->
    <rewrite>
      <rules>
        <clear />

        <!-- RULE 1: Checklist / DWM API (Port 8002) -->
        <!-- Note: If your deployed device runs Checklist on port 8001 and MPS on 8002, swap ports 8001 & 8002 -->
        <rule name="ReverseProxy_ChecklistAPI" stopProcessing="true">
          <match url="^api/v1/checklist(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:8002/api/v1/checklist{R:1}" appendQueryString="true" />
        </rule>

        <!-- RULE 2: MPS API - Prefixed Routes (/api/mps/...) (Port 8001) -->
        <rule name="ReverseProxy_MPS_Prefixed" stopProcessing="true">
          <match url="^api/mps(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:8001/api{R:1}" appendQueryString="true" />
        </rule>

        <!-- RULE 3: MPS API - Direct Endpoints under /api/ (Port 8001) -->
        <!-- Intercepts BOM, Components, Weeks, Monthly Plans, MB51, Stock, Plan Freeze, Vendor Schedules, etc. -->
        <rule name="ReverseProxy_MPS_Direct" stopProcessing="true">
          <match url="^api/(bom|components|vendor-buyers|weeks|monthly-plans|mb51|stock|plan-freeze|monday-review-actions|vendor-schedule|vendor-delivery-schedules|uploads|exports)(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:8001/{R:0}" appendQueryString="true" />
        </rule>

        <!-- RULE 4: MPS API - Monday Review Cockpit Report (Port 8001) -->
        <rule name="ReverseProxy_MPS_MondayCockpit" stopProcessing="true">
          <match url="^api/reports/monday-review-cockpit(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:8001/{R:0}" appendQueryString="true" />
        </rule>

        <!-- RULE 5: Main Django Core API - Kaizen, Workflow, PPSR, Auth, etc. (Port 8000) -->
        <rule name="ReverseProxy_DjangoAPI" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/api/{R:1}" appendQueryString="true" />
        </rule>

        <!-- RULE 6: Django Admin (Port 8000) -->
        <rule name="ReverseProxy_DjangoAdmin" stopProcessing="true">
          <match url="^admin/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/admin/{R:1}" appendQueryString="true" />
        </rule>

        <!-- RULE 7: Django Static Files (Port 8000) -->
        <rule name="ReverseProxy_DjangoStatic" stopProcessing="true">
          <match url="^static/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/static/{R:1}" appendQueryString="true" />
        </rule>

        <!-- RULE 8: Django Media / Uploaded Files (Port 8000) -->
        <rule name="ReverseProxy_DjangoMedia" stopProcessing="true">
          <match url="^media/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/media/{R:1}" appendQueryString="true" />
        </rule>

        <!-- RULE 9: MinIO Public Static Media (Read-Only Bucket Fetching) -->
        <rule name="ReverseProxy_MinIO_KaizenImages" stopProcessing="true">
          <match url="^kaizenimages/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/media/kaizenimages/{R:1}" appendQueryString="true" />
        </rule>

        <rule name="ReverseProxy_MinIO_TPMEvidence" stopProcessing="true">
          <match url="^tpm-evidence/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/media/tpm-evidence/{R:1}" appendQueryString="true" />
        </rule>

        <!-- RULE 10: React / Vite SPA Routing Fallback -->
        <rule name="React_SPA_Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(api|admin|static|media|kaizenimages|tpm-evidence)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>

      </rules>
    </rewrite>

    <!-- 3. Static Content, MIME Types & Caching -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <!-- 4. Disable IIS default error pages so backend APIs return real JSON errors -->
    <httpErrors existingResponse="PassThrough" />

    <!-- 5. Security Headers -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
