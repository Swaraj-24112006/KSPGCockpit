# =============================================================================
# Kaizen Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.

# Django Settings
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True

# Database Configuration (PostgreSQL)
DATABASE_NAME=kaizen_db
DATABASE_USER=postgres
DATABASE_PASSWORD=swaraj2006
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# CORS - Frontend Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# JWT Token Lifetimes (minutes)
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# File Upload
MAX_UPLOAD_SIZE_MB=10

# Redis Session Store (local offline)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=kaizen
REDIS_PASSWORD=swaraj2006
REDIS_DB=0
# Session cookie lifetime in seconds (3600 = 60 min, matches JWT access token)
SESSION_COOKIE_AGE=3600
# Max concurrent sessions per user (oldest auto-evicted above this limit)
MAX_CONCURRENT_SESSIONS=5

# Twilio Credentials
TWILIO_PHONE_NUMBER=+17372212163

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=kaizenimages
MINIO_USE_HTTPS=False

# SMTP Email Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=swaraj.matre24@pccoepune.org
EMAIL_HOST_PASSWORD=hfakvbyisdiatwji
DEFAULT_FROM_EMAIL=KSPG Cockpit <swaraj.matre24@pccoepune.org>
