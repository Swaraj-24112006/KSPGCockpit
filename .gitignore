# =============================================================================
# KSPG Cockpit Monorepo — .gitignore
# =============================================================================

# ── Environment & Secrets ────────────────────────────────────────────────────
# Never commit credentials, passwords, or secret keys
.env
.env.*
.env.local
*.env
!.env.example
!Backend/.env.example
!Frontend/.env.example
!MPS/Backend/.env.example
!Checklist-main/.env.example

# ── Python & Django ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.sqlite3
db.sqlite3
*.log

# Media, uploads & collected static files
Backend/media/
MPS/Backend/media/
MPS/Backend/staticfiles/
Checklist-main/backend/media/
Checklist-main/backend/staticfiles/

# Python test caches & coverage
.pytest_cache/
.coverage
htmlcov/

# ── Node & Frontend ──────────────────────────────────────────────────────────
node_modules/
dist/
build/
coverage/
.next/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ── Legacy MPS Frontend (Consolidated into Frontend/src/mps/) ─────────────────
# The standalone MPS frontend is not pushed as all MPS UI components, hooks,
# types, and services have been migrated into Frontend/src/mps/.
MPS/Frontend/

# ── OS & IDE Artifacts ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
